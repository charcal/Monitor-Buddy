# Copy to .env and fill in. Lines left empty switch that feature off.

# ── Where things run ────────────────────────────────────────
# Your fork on GitHub, owner/name. The flasher and firmware come from here.
GITHUB_REPO=
# The server's mDNS name and LAN address; both go in the HTTPS certificate.
FLASHER_HOST=cal-mini.local
FLASHER_IP=192.168.86.48
# Flasher: https://cal-mini.local:8443  ·  root certificate: http://cal-mini.local:8780/root.crt
FLASHER_PORT=8443
CERT_PORT=8780
# The Buddy reaches the bridge at http://FLASHER_IP:BRIDGE_PORT
BRIDGE_PORT=8787
# CasaOS keeps app data under /DATA/AppData
APPDATA=/DATA/AppData/monitor-buddy
# Optional: a GitHub token (no scopes needed for a public fork) raises the
# rate limit; a private fork needs one with read access to it.
GITHUB_TOKEN=
FLASHER_REF=main
SYNC_MINUTES=30

# ── Bridge ──────────────────────────────────────────────────
TZ=Europe/London
# Optional shared secret. Set the same value as "Bridge key" in the flasher.
BUDDY_KEY=

# Phone Buddy (pocket e-ink, docs/phone-buddy.md). PHONE_KEY guards /eink/:
# make it long and random (openssl rand -hex 16) and type the same into the
# Buddy's setup page. Requests through Tailscale Funnel are refused without it.
PHONE_KEY=
# The screens the button steps through, in order. news = the newest headline,
# news:2 the second, and so on. EINK_THEME=dark for white on black, like Monitor Buddy.
EINK_VIEWS=news,news:2,travel,cal,fpl
EINK_THEME=
# Rail lines for the Travel screen, if different from the desk Buddy's RAIL_LINES
# (same format). Only lines with problems are shown. Example: elizabeth=LIZZIE
EINK_RAIL=

# Home Assistant: a long-lived access token (your profile > Security), and up
# to three entities, each optionally with the label to show.
HA_URL=http://192.168.86.48:8123
HA_TOKEN=
HA_ENTITIES=sensor.living_room_temperature=Living room, sensor.house_power=Power, binary_sensor.front_door=Front door

# Now playing: whichever of these are set, checked in NOWPLAYING_ORDER. A
# source that's playing wins over one that's paused.
NOWPLAYING_ORDER=plex,jellyfin,spotify
PLEX_URL=http://192.168.86.48:32400
PLEX_TOKEN=
# Only show this Plex/Jellyfin user's sessions (empty: anyone's)
PLEX_USER=
JELLYFIN_URL=http://192.168.86.48:8096
JELLYFIN_API_KEY=
JELLYFIN_USER=
# Spotify: create an app at developer.spotify.com, add the redirect URI
#   https://cal-mini.local:8443/bridge/spotify/callback
# then open https://cal-mini.local:8443/bridge/spotify/login once to link it.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Calendar: one or more ICS links, comma separated. For Google Calendar use
# Settings > your calendar > "Secret address in iCal format".
CAL_ICS_URLS=
CAL_DAYS=7
# 1 hides events marked "free" (transparent)
CAL_SKIP_FREE=

# Next bus (TfL): up to three stops, by the 5-digit code on the bus stop sign
# (or the stop's NaPTAN id from tfl.gov.uk, e.g. 490012345N), each optionally
# =Label. TFL_LINES limits which routes are shown; empty shows all.
# To pick routes per stop, add them after a colon: 490009803W:89=Memorial Hospital
# (several with +, e.g. :89+N89).
TFL_STOPS=
TFL_LINES=89,244
# Optional: a free key from api-portal.tfl.gov.uk raises TfL's rate limit.
TFL_APP_KEY=

# Fantasy Premier League: the number in your Points page address,
# fantasy.premierleague.com/entry/1234567/event/9 -> 1234567
FPL_TEAM_ID=
# Optional: show your rank in one of your classic leagues instead of overall,
# fantasy.premierleague.com/leagues/797425/standings/c -> 797425
FPL_LEAGUE_ID=

# MiSTer now playing: the MiSTer's address with Zaparoo's port
MISTER_URL=

# News headlines: RSS or Atom feed links, comma separated, each optionally
# =Label. Empty shows BBC News top stories. Others to try:
#   https://feeds.bbci.co.uk/news/technology/rss.xml=BBC TECH
#   https://feeds.bbci.co.uk/sport/football/rss.xml=BBC FOOTBALL
NEWS_FEEDS=
NEWS_MAX=8

# Tube and rail status: TfL line ids, comma separated, each optionally =Label.
# Tube lines by name (jubilee, northern...), elizabeth, dlr, and rail
# operators like southeastern, thameslink, southern.
RAIL_LINES=elizabeth,dlr,southeastern

# Bin day: each bin as NAME=a collection date/every N days.
#   BINS=BLACK=2026-10-27/14, BLUE=2026-11-03/14, FOOD=2026-10-27/7
# A bank holiday earlier in the same week pushes a collection back a day
# (gov.uk's list). BIN_BANK_HOLIDAYS: england-and-wales, scotland,
# northern-ireland, or off.
BINS=
BIN_BANK_HOLIDAYS=england-and-wales
